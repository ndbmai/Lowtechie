# Tách câu lệnh + đọc ảnh bằng Claude API (thiếu key: chat vẫn chạy bộ luật, ảnh thì không)
ANTHROPIC_API_KEY=
# Chỉ cần khi key là loại cấp org chưa gắn workspace (lỗi "not scoped to a workspace")
ANTHROPIC_WORKSPACE_ID=
# Model cho việc tách lệnh (mặc định claude-sonnet-5)
LOWTECHIE_MODEL=

# Nối Google Calendar (PRD §5.4) — tạo OAuth client "Web application" tại
# console.cloud.google.com, bật Google Calendar API, redirect URI:
#   https://lowtechie.vercel.app/api/google/callback
#   http://localhost:3000/api/google/callback
# Refresh token nằm trong cookie httpOnly đã mã hóa (khóa dẫn xuất từ
# GOOGLE_CLIENT_SECRET) — đổi secret là mọi thiết bị phải nối lại.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps Routes API (§5.4.1) — cùng project Google Cloud: bật
# "Routes API", tạo API key (khác OAuth client). Có key là form chuỗi
# có nút "Tính thời gian bằng Google Maps".
GOOGLE_MAPS_API_KEY=

# Voice → chữ (PRD §5.0 v2.0): ghi âm trên máy gửi lên Whisper (hỗ trợ
# tiếng Việt/Thái/Anh). Thiếu key: rơi về nhận dạng của trình duyệt
# (không ổn định, nhất là iPhone) — nên thêm key này để voice chạy chuẩn.
OPENAI_API_KEY=
# Model STT (mặc định whisper-1)
LOWTECHIE_STT_MODEL=

# Lark (PRD §5.3.4 + §5.5.1) — app trên open.larksuite.com (bản quốc tế).
# Redirect URL (Security Settings): https://lowtechie.vercel.app/api/lark/callback
# Cookie Lark mã hóa bằng khóa dẫn xuất từ LARK_APP_SECRET.
LARK_APP_ID=
LARK_APP_SECRET=
# Ghi đè scope user token khi khai báo trên console đổi (không cần deploy)
LARK_OAUTH_SCOPES=

# Bot "Mai Lowtechie" trong group (§5.5.1 v3.7) — Events & Callbacks →
# Encryption Strategy. Request URL: https://lowtechie.vercel.app/api/lark/events
LARK_VERIFICATION_TOKEN=
# Có đặt Encrypt Key trên console thì PHẢI điền ở đây (giải mã + kiểm chữ ký)
LARK_ENCRYPT_KEY=
# open_id của Mai trong app — để trống thì người đầu tiên mở app khi đã có hàng đợi được nhận
LARK_OWNER_OPEN_ID=

# Hàng đợi bot → Hộp duyệt: Upstash Redis (Vercel → Storage → Marketplace
# tự thêm hai biến này). Server chỉ giữ tạm tới khi app kéo về rồi xóa.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Giai đoạn sau (chưa dùng) ─────────────────────────────
# Supabase (Giai đoạn 3 — tài khoản cộng sự + RLS)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
